{
  "name": "pickday",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute pickday-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute pickday-db --remote --file=schema.sql",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
